{
  "name": "pomposo-y-peligroso-landing",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Landing de captación para Meta Ads de Pomposo y Peligroso",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "npm run test:unit && npm run test:apps-script && npm run build && npm run test:static",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:static": "node --test \"tests/static/*.test.mjs\"",
    "test:apps-script": "node --test apps-script/test/code.test.mjs",
    "test:e2e": "playwright test",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "check": "astro check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "html-validate": "^9.7.1",
    "typescript": "^6.0.3"
  }
}
