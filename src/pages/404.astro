---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
---

<Base title={`Página no encontrada · ${SITE.name}`} path="/404" noindex description="Esta página no existe.">
  <section class="nf container">
    <svg class="nf__mono" viewBox="0 0 1584 1584" aria-hidden="true" focusable="false"><use href="#pyp-mono"></use></svg>
    <h1 class="t-center">Esta página se ha ido <span class="script">a entrenar.</span></h1>
    <p>No la encontramos. Vuelve al inicio y sigue por donde ibas.</p>
    <a class="btn btn--block-mobile" href="/">Volver al inicio</a>
  </section>
</Base>

<style>
  .nf {
    max-width: calc(720px + var(--gutter) * 2);
    padding-top: clamp(48px, 8vw, 104px);
    padding-bottom: clamp(80px, 10vw, 140px);
    text-align: center;
  }
  .nf__mono {
    width: 120px;
    height: 120px;
    margin: 0 auto 28px;
  }
  .nf h1 {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.5rem);
  }
  .nf p {
    margin: 18px 0 32px;
    color: var(--muted);
  }
</style>
