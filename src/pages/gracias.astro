---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, hasWhatsApp, hasPhone, whatsappUrl, phoneText } from '../config/site';

// Esta página NO dispara ningún evento de conversión (el Lead se envía al confirmar el Apps Script).
const contactNumber = hasPhone ? phoneText : hasWhatsApp ? `+${SITE.whatsappNumber}` : '';
const steps = [
  { t: 'Te escribimos.', d: 'Por WhatsApp, muy pronto, para conocerte un poco.' },
  { t: 'Videollamada.', d: 'Vemos tu situación, tus objetivos y si el programa encaja contigo.' },
  { t: 'Empiezas.', d: 'Tus 12 semanas con tu plan y tu entrenadora pendiente de ti.' },
];
---

<Base title={`Gracias · ${SITE.name}`} path="/gracias" noindex headerCta={false} description="Hemos recibido tus datos. Te escribimos muy pronto por WhatsApp.">
  <section class="thanks container">
    <svg class="thanks__mono" viewBox="0 0 1584 1584" aria-hidden="true" focusable="false"><use href="#pyp-mono"></use></svg>
    <h1 data-thanks-title>Ya está.</h1>
    <p class="thanks__lead">
      Te escribimos por WhatsApp muy pronto para agendar tu videollamada.
      {
        contactNumber ? (
          <>
            Guarda nuestro número para que no se te pierda el mensaje: <strong>{contactNumber}</strong>.
          </>
        ) : (
          <>Estate atenta a WhatsApp para que no se te pierda el mensaje.</>
        )
      }
    </p>
    <div class="thanks__ctas">
      {
        hasWhatsApp && (
          <a class="btn btn--block-mobile" href={whatsappUrl()} target="_blank" rel="noopener" data-contact="whatsapp" data-location="gracias">
            <Icon name="whatsapp" size={22} /> Escríbenos ya por WhatsApp
          </a>
        )
      }
      <a class:list={['btn btn--block-mobile', hasWhatsApp && 'btn--ghost']} href={SITE.instagram} target="_blank" rel="noopener">
        <Icon name="instagram" size={22} /> Ver nuestro Instagram
      </a>
    </div>

    <h2 class="thanks__subtitle">Lo que pasa <span class="script">ahora.</span></h2>
    <ol class="thanks__steps" role="list">
      {
        steps.map((s, i) => (
          <li>
            <span class="thanks__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<script>
  // Personaliza el titular con el nombre guardado al enviar el formulario (nunca viaja por la URL).
  try {
    const name = (sessionStorage.getItem('pyp_lead_name') || '').trim().split(/\s+/)[0]?.slice(0, 30);
    const h1 = document.querySelector('[data-thanks-title]');
    if (name && h1) {
      h1.textContent = 'Ya está, ';
      const span = document.createElement('span');
      span.className = 'script';
      span.textContent = `${name}.`;
      h1.appendChild(span);
    }
  } catch {
    /* sin sessionStorage: se queda "Ya está." */
  }
</script>

<style>
  .thanks {
    max-width: calc(760px + var(--gutter) * 2);
    padding-top: clamp(40px, 7vw, 88px);
    padding-bottom: clamp(72px, 10vw, 128px);
    text-align: center;
  }
  .thanks__mono {
    width: 88px;
    height: 88px;
    margin: 0 auto 24px;
  }
  .thanks h1 {
    font-size: clamp(2.75rem, 1.8rem + 4.5vw, 5rem);
  }
  .thanks__lead {
    max-width: 34rem;
    margin: 18px auto 0;
    color: var(--muted);
  }
  .thanks__lead strong {
    color: var(--ink);
    white-space: nowrap;
  }
  .thanks__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  .btn--ghost {
    --btn-bg: var(--white);
    --btn-bg-hover: var(--lilac-50);
    --btn-fg: var(--purple);
    box-shadow: inset 0 0 0 1.5px var(--purple);
  }
  .btn--ghost:hover {
    box-shadow: inset 0 0 0 1.5px var(--purple);
  }
  .thanks__subtitle {
    margin-top: clamp(56px, 8vw, 88px);
  }
  .thanks__steps {
    display: grid;
    gap: 14px;
    margin: 28px 0 0;
    padding: 0;
    text-align: left;
  }
  .thanks__steps li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--lilac-50);
  }
  .thanks__num {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--lilac);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: 1.25rem;
  }
  .thanks__steps h3 {
    font-size: 1.375rem;
    margin: 4px 0 4px;
  }
  .thanks__steps p {
    color: var(--muted);
  }
  @media (min-width: 760px) {
    .thanks__steps {
      grid-template-columns: repeat(3, 1fr);
    }
    .thanks__steps li {
      flex-direction: column;
    }
  }
</style>
