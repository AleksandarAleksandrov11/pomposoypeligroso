---
import Base from './Base.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
---

<Base title={`${title} · ${SITE.name}`} description={description} path={path} noindex>
  <article class="legal container">
    <header class="legal__head">
      <h1>{title}</h1>
      <p class="legal__date">Última actualización: {SITE.legal.updatedAt}</p>
    </header>
    <div class="legal__body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    max-width: calc(720px + var(--gutter) * 2);
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(72px, 9vw, 120px);
  }
  .legal__head h1 {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.5rem);
  }
  .legal__date {
    margin-top: 12px;
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .legal__body {
    margin-top: 36px;
    font-size: 1.0625rem;
  }
  .legal__body :global(h2) {
    margin: 40px 0 12px;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 1.875rem);
    line-height: 1.1;
  }
  .legal__body :global(h3) {
    margin: 24px 0 8px;
    font-family: var(--font-text);
    font-stretch: normal;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .legal__body :global(p),
  .legal__body :global(ul),
  .legal__body :global(ol) {
    margin: 0 0 14px;
  }
  .legal__body :global(ul),
  .legal__body :global(ol) {
    padding-left: 1.25em;
  }
  .legal__body :global(li) {
    margin-bottom: 6px;
  }
  .legal__body :global(a) {
    color: var(--purple);
    font-weight: 600;
    overflow-wrap: anywhere;
    text-underline-offset: 3px;
  }
  .legal__body :global(dl) {
    display: grid;
    gap: 4px 16px;
    margin: 0 0 14px;
    padding: 18px 20px;
    border-radius: var(--radius-sm);
    background: var(--lilac-50);
  }
  .legal__body :global(dt) {
    font-weight: 600;
  }
  .legal__body :global(dd) {
    margin: 0 0 8px;
  }
  @media (min-width: 600px) {
    .legal__body :global(dl) {
      grid-template-columns: max-content 1fr;
    }
    .legal__body :global(dd) {
      margin: 0;
    }
  }
  .legal__body :global(.table-wrap) {
    margin: 0 0 18px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .legal__body :global(table) {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }
  .legal__body :global(th),
  .legal__body :global(td) {
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  .legal__body :global(th) {
    background: var(--lilac-50);
    font-weight: 600;
  }
  .legal__body :global(tr:last-child td) {
    border-bottom: 0;
  }
  /* En móvil, la tabla se apila en tarjetas para no tener que desplazarse en horizontal */
  @media (max-width: 599px) {
    .legal__body :global(.table-wrap--stack) {
      overflow: visible;
      border: 0;
    }
    .legal__body :global(.table-wrap--stack table) {
      min-width: 0;
    }
    .legal__body :global(.table-wrap--stack thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .legal__body :global(.table-wrap--stack tr) {
      display: block;
      margin-bottom: 12px;
      padding: 6px 0;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
    }
    .legal__body :global(.table-wrap--stack td) {
      display: grid;
      grid-template-columns: 96px 1fr;
      gap: 10px;
      padding: 8px 14px;
      border: 0;
    }
    .legal__body :global(.table-wrap--stack td::before) {
      content: attr(data-label);
      font-weight: 600;
      color: var(--ink);
    }
  }
</style>
