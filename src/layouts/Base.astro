---
import '../styles/tokens.css';
import '../styles/base.css';
import { SITE } from '../config/site';
import { AD_VARIANT_RULES } from '../data/ad-variants';
import MonoSprite from '../components/MonoSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import CookieModal from '../components/CookieModal.astro';
import Pixel from '../components/Pixel.astro';

interface Props {
  title?: string;
  description?: string;
  /** Ruta canónica (sin dominio), ej. '/' o '/privacidad'. */
  path?: string;
  noindex?: boolean;
  home?: boolean;
  /** Texto y destino del enlace "saltar". */
  skipTo?: { href: string; label: string };
  headerCta?: boolean;
}

const {
  title = 'Pomposo y Peligroso · Programa online para mujeres +30',
  description = 'Programa online de 12 semanas para mujeres +30: fuerza 3 días por semana, nutrición sin dietas restrictivas y seguimiento semanal con tu coach.',
  path = '/',
  noindex = false,
  home = false,
  skipTo = { href: '#contenido', label: 'Saltar al contenido' },
  headerCta = true,
} = Astro.props;

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(path, site).href.replace(/\/$/, path === '/' ? '/' : '');
const ogImage = new URL('/og.jpg', site).href;

// Antes del primer pintado: clase js, fonts-pending (el titular y el subtítulo del hero esperan a sus fuentes, ver Hero.astro)
// y, si no hay consentimiento válido guardado, needs-consent (el hero reserva el hueco del aviso de cookies
// sin mover nada después). Misma regla que readConsent().
const headScript = `(function(d){d.classList.add('js');if(document.fonts&&document.fonts.load){d.classList.add('fonts-pending');var f=function(){d.classList.remove('fonts-pending')};setTimeout(f,1200);requestAnimationFrame(function(){Promise.all([document.fonts.load('400 1em Anton'),document.fonts.load('400 1em Allura'),document.fonts.load('400 1em Inter')]).then(f,f)})}try{var c=JSON.parse(localStorage.getItem('pyp_consent')||'null');if(!c||c.v!==${SITE.consentVersion}||!c.date||Date.now()-new Date(c.date).getTime()>31536e6)d.classList.add('needs-consent')}catch(e){d.classList.add('needs-consent')}})(document.documentElement);`;

// Antes del primer pintado: versión del inicio según el anuncio (src/data/ad-variants.ts). Lee utm_content y, si no
// encaja con ninguna regla, utm_campaign; la guarda en sessionStorage (pyp_ad_variant) y pone data-ad en <html>.
// Sin parámetros en la URL usa la versión guardada. Mismas reglas que pickVariant().
const adRules = JSON.stringify(AD_VARIANT_RULES.map((r) => ({ v: r.variant, m: r.match.map((m) => m.toLowerCase()) })));
const adScript = `(function(d){try{var R=${adRules},q=new URLSearchParams(location.search),c=q.get('utm_content'),k=q.get('utm_campaign'),K='pyp_ad_variant',v=null;function m(x){x=(x||'').toLowerCase();if(!x)return null;for(var i=0;i<R.length;i++)for(var j=0;j<R[i].m.length;j++)if(x.indexOf(R[i].m[j])>-1)return R[i].v;return null}if(c||k){v=m(c)||m(k);if(v)sessionStorage.setItem(K,v);else sessionStorage.removeItem(K)}else v=sessionStorage.getItem(K);for(var n=0;n<R.length;n++)if(R[n].v===v){d.setAttribute('data-ad',v);break}}catch(e){}})(document.documentElement);`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#B9A4F2" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline set:html={headScript} />
    <script is:inline set:html={adScript} />

    <link rel="preload" href="/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/allura-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pomposo y Peligroso: un glúteo pomposo y peligroso. Programa online para mujeres +30." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/*
      HUECO PARA OTROS PÍXELES (TikTok, Google Ads, GA4...).
      No pegues aquí sus snippets directamente: tienen que cargarse solo con consentimiento.
      Añade su cargador en src/scripts/consent.ts, dentro de applyConsent(), igual que se
      hace con loadMetaPixel(). Así respetan el mismo banner y el mismo modal de cookies.
    */}
  </head>
  <body id="top">
    <a class="skip-link" href={skipTo.href}>{skipTo.label}</a>
    <MonoSprite />
    <Header home={home} cta={headerCta} />
    <main id="contenido" class:list={[{ 'main--home': home }]}>
      <slot />
    </main>
    <Footer home={home} />
    <slot name="after-footer" />
    <CookieBanner />
    <CookieModal />
    <Pixel />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
