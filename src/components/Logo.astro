---
interface Props {
  href?: string;
  variant?: 'header' | 'footer';
}
const { href = '/', variant = 'header' } = Astro.props;
---

<a class:list={['logo', `logo--${variant}`]} href={href} aria-label="Pomposo y Peligroso, ir al inicio">
  <svg class="logo__mark" viewBox="0 0 1584 1584" aria-hidden="true" focusable="false"><use href="#pyp-mono"></use></svg>
  <span class="logo__text" aria-hidden="true"><span>Pomposo</span> <span>y Peligroso</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    border-radius: 12px;
  }
  .logo__mark {
    width: 44px;
    height: 44px;
    flex: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.1875rem;
    line-height: 0.98;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  @media (min-width: 480px) {
    .logo__text {
      flex-direction: row;
      gap: 0.3em;
      font-size: 1.4375rem;
      line-height: 1;
    }
    .logo__mark {
      width: 46px;
      height: 46px;
    }
  }
  .logo--footer {
    color: var(--white);
  }
  .logo--footer .logo__mark {
    width: 52px;
    height: 52px;
  }
  .logo--footer .logo__text {
    flex-direction: row;
    gap: 0.3em;
    font-size: 1.5rem;
    line-height: 1;
  }
</style>
