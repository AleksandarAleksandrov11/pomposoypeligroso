---
import Pic from './Pic.astro';
import dani from '../assets/img/equipo-dani.jpg';
import adri from '../assets/img/equipo-adri.jpg';
import flor from '../assets/img/equipo-flor.jpg';
import fede from '../assets/img/equipo-fede.jpg';

// Textos sacados de la presentación que ha escrito cada coach (Drive del equipo).
const team = [
  { name: 'Dani', full: 'Daniel Pueyo', img: dani, bio: 'Entrenador personal, Técnico Superior en AAFE. Más de 10 años ayudándote a sacar tu mejor versión.' },
  { name: 'Adri', full: 'Adri Moruno', img: adri, bio: 'Graduado en Ciencias de la Actividad Física y del Deporte. Más de 10 años en entrenamiento y salud.' },
  { name: 'Flor', full: 'Flor Madia', img: flor, bio: 'Entrenadora personal y coach online. Fuerza y entrenamiento híbrido, sin vivir a dieta.' },
  { name: 'Fede', full: 'Fede', img: fede, bio: 'Coach del equipo de Pomposo y Peligroso.' },
];
---

<section class="section bg-lilac coach" aria-labelledby="coach-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="coach-title">Detrás de cada glúteo pomposo <span class="script script--low">hay un equipo.</span></h2>
      <p>Somos The Monkeys, un centro de entrenamiento en Gavà. Trabajamos con pocas alumnas a la vez para dedicarte tiempo de verdad.</p>
    </div>

    <ul class="team" role="list">
      {
        team.map((c) => (
          <li class="team__card" data-reveal>
            <Pic src={c.img} widths={[320, 480, 640]} sizes="(min-width: 1100px) 260px, (min-width: 700px) 30vw, 46vw" alt={`${c.full}, coach de Pomposo y Peligroso`} class="team__img" />
            <div class="team__body">
              <h3>{c.name}</h3>
              <p>{c.bio}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="section-cta" data-reveal>
      <a class="btn btn--block-mobile" href="#formulario" data-cta="equipo">Quiero mi plaza</a>
    </div>
  </div>
</section>

<style>
  .team {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: clamp(32px, 5vw, 56px) 0 0;
    padding: 0;
  }
  .team__card {
    overflow: hidden;
    border-radius: 22px;
    background: var(--white);
    box-shadow: 0 20px 40px -32px rgb(75 42 145 / 0.55);
  }
  .team__card :global(.team__img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--lilac-100);
  }
  .team__body {
    padding: 14px 14px 18px;
  }
  .team__body h3 {
    font-size: 1.5rem;
  }
  .team__body p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  @media (min-width: 1100px) {
    .team {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    .team__body {
      padding: 18px 20px 22px;
    }
    .team__body h3 {
      font-size: 1.75rem;
    }
    .team__body p {
      font-size: var(--fs-small);
    }
  }
</style>
