---
import Pic from './Pic.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { featured, transformations } from '../data/transformations';
import { gallery } from '../data/gallery';
import { testimonials, testimonialPlaceholders, SHOW_TESTIMONIAL_PLACEHOLDERS, type Testimonial } from '../data/testimonials';

const show = SITE.showTransformations;
const featuredOk = show && !!featured.image;
const transformationCards = show ? transformations.filter((t) => t.image) : [];

// Fila de fotos: transformaciones autorizadas si las hay; si no, fotos de entrenamiento.
const photos =
  transformationCards.length >= 4
    ? transformationCards.map((t) => ({ src: t.image!, alt: t.alt ?? `Antes y después de ${t.name}`, name: t.name }))
    : gallery.map((g) => ({ ...g, name: '' }));

// Fila de testimonios: reales (mínimo 2) o huecos de diseño claramente marcados.
const realTestimonials = testimonials.length >= 2;
const quotes: Testimonial[] = realTestimonials ? testimonials : SHOW_TESTIMONIAL_PLACEHOLDERS ? testimonialPlaceholders : [];
const isPlaceholder = !realTestimonials;
---

<section class="section bg-blush results" id="resultados" aria-labelledby="results-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="results-title">Mujeres normales <span class="script">cambios reales.</span></h2>
      <p>+30 alumnas han pasado ya por el programa.</p>
    </div>

    {
      featuredOk && (
        <article class="results__featured" data-reveal>
          <Pic src={featured.image!} widths={[480, 768, 1080]} sizes="(min-width: 900px) 520px, calc(100vw - 40px)" alt={featured.alt ?? featured.name} class="results__featured-img" />
          <div>
            <h3>{featured.name}</h3>
            <p>{featured.line}</p>
          </div>
        </article>
      )
    }
  </div>

  <!-- Fila 1: fotos, se mueve hacia la izquierda -->
  <div class="marquee-row marquee-row--photos" data-reveal>
    <div class="marquee-row__track">
      {
        [0, 1].map((copy) => (
          <ul class="marquee-row__list" role="list" aria-label={copy === 0 ? 'Fotos de entrenamiento' : undefined} aria-hidden={copy === 1 ? 'true' : undefined}>
            {photos.map((p) => (
              <li class="photo-card">
                <Pic src={p.src} widths={[320, 480, 640]} sizes="(min-width: 768px) 280px, 220px" alt={copy === 0 ? p.alt : ''} class="photo-card__img" />
                {p.name && <span class="photo-card__name">{p.name}</span>}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  {
    quotes.length > 0 && (
      <div class="marquee-row marquee-row--quotes" data-reveal>
        <h3 class="visually-hidden">Lo que dicen ellas</h3>
        <div class="marquee-row__track">
          {[0, 1].map((copy) => (
            <ul class="marquee-row__list" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {quotes.map((t) => (
                <li class:list={['quote-card', isPlaceholder && 'quote-card--placeholder']}>
                  <Icon name="quote" size={28} class="quote-card__icon" />
                  <p class="quote-card__text">{t.quote}</p>
                  <p class="quote-card__name">{t.name}</p>
                  <p class="quote-card__context">{t.context}</p>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    )
  }

  <div class="container">
    {(featuredOk || transformationCards.length >= 4) && <p class="micro results__disclaimer">Resultados individuales. Pueden variar según cada persona.</p>}
    <div class="section-cta" data-reveal>
      <a class="btn btn--block-mobile" href="#formulario" data-cta="resultados">Quiero ser la siguiente</a>
    </div>
  </div>
</section>

<style>
  .results {
    overflow: hidden;
  }
  .results__featured {
    display: grid;
    gap: 24px;
    align-items: center;
    max-width: 960px;
    margin: clamp(32px, 5vw, 56px) auto 0;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--white);
  }
  .results__featured :global(.results__featured-img) {
    width: 100%;
    border-radius: var(--radius-sm);
  }
  .results__featured h3 {
    margin-bottom: 10px;
  }

  /* Filas en bucle infinito: dos copias de la lista, la pista se desplaza el 50 % */
  .marquee-row {
    margin-top: clamp(36px, 5vw, 56px);
    overflow: hidden;
  }
  .marquee-row + .marquee-row {
    margin-top: 18px;
  }
  .marquee-row__track {
    display: flex;
    width: max-content;
    animation: row-left 70s linear infinite;
  }
  .marquee-row--quotes .marquee-row__track {
    animation-name: row-right;
    animation-duration: 80s;
  }
  .marquee-row:hover .marquee-row__track,
  .marquee-row:focus-within .marquee-row__track {
    animation-play-state: paused;
  }
  .marquee-row__list {
    display: flex;
    flex: none;
    gap: 14px;
    margin: 0;
    padding: 0 14px 0 0;
  }
  @keyframes row-left {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes row-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: none;
    }
  }

  .photo-card {
    position: relative;
    flex: none;
    width: 220px;
  }
  .photo-card :global(.photo-card__img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 18px;
    background: var(--lilac-50);
  }
  .photo-card__name {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--white);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .quote-card {
    display: flex;
    flex-direction: column;
    flex: none;
    width: 290px;
    padding: 22px 22px 20px;
    border-radius: 18px;
    background: var(--white);
    box-shadow: 0 14px 30px -24px rgb(214 63 132 / 0.6);
  }
  .quote-card :global(.quote-card__icon) {
    color: var(--pink);
    margin-bottom: 10px;
  }
  .quote-card__text {
    flex: 1;
    font-size: 1rem;
    line-height: 1.45;
  }
  .quote-card__name {
    margin-top: 16px;
    font-weight: 600;
  }
  .quote-card__context {
    color: var(--muted);
    font-size: var(--fs-small);
  }
  /* Hueco de diseño: se nota que falta el testimonio real */
  .quote-card--placeholder {
    background: rgb(255 255 255 / 0.65);
    border: 1.5px dashed #e8b6cd;
    box-shadow: none;
  }
  .quote-card--placeholder .quote-card__text {
    color: var(--muted);
    font-style: italic;
  }

  .results__disclaimer {
    margin-top: 16px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .photo-card {
      width: 280px;
    }
    .marquee-row__list {
      gap: 18px;
      padding-right: 18px;
    }
    .quote-card {
      width: 340px;
      padding: 26px 26px 22px;
    }
  }
  @media (min-width: 900px) {
    .results__featured {
      grid-template-columns: 1fr 1fr;
      padding: 28px;
      gap: 40px;
    }
  }

  /* Sin movimiento: filas estáticas que se deslizan con el dedo */
  @media (prefers-reduced-motion: reduce) {
    .marquee-row {
      overflow-x: auto;
      scrollbar-width: none;
      padding-inline: var(--gutter);
    }
    .marquee-row::-webkit-scrollbar {
      display: none;
    }
    .marquee-row__track {
      animation: none;
    }
    .marquee-row__list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
