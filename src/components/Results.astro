---
import Pic from './Pic.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { featured, transformations } from '../data/transformations';
import { testimonials } from '../data/testimonials';

// Antes/después solo con el interruptor encendido (autorización de las alumnas, ver PENDIENTES.md).
const show = SITE.showTransformations;
---

<section class="section bg-blush results" id="resultados" aria-labelledby="results-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="results-title">Mujeres normales <span class="script">cambios reales.</span></h2>
      <p>Alumnas reales del programa. Sin filtros.</p>
    </div>

    {
      show && (
        <article class="featured" data-reveal aria-labelledby="featured-name">
          <div class="featured__media">
            <Pic src={featured.image} widths={[480, 768, 1100]} sizes="(min-width: 960px) 560px, calc(100vw - 40px)" alt={featured.alt} class="featured__img" />
            <span class="ba-label ba-label--before" aria-hidden="true">Antes</span>
            <span class="ba-label ba-label--after" aria-hidden="true">Después</span>
          </div>
          <div class="featured__body">
            <h3 id="featured-name">
              El caso de {featured.name}
            </h3>
            <ul class="featured__stats" role="list">
              {featured.stats.map((s) => (
                <li>
                  <span class="featured__num">{s.n}</span>
                  <span class="featured__label">{s.t}</span>
                </li>
              ))}
            </ul>
            <blockquote class="featured__quote">
              <p>{featured.quote}</p>
            </blockquote>
          </div>
        </article>
      )
    }
  </div>

  {
    show && (
      <div class="marquee-row marquee-row--photos" data-reveal>
        <h3 class="visually-hidden">Más antes y después</h3>
        <div class="marquee-row__track">
          {[0, 1].map((copy) => (
            <ul class="marquee-row__list" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {transformations.map((t) => (
                <li class="ba-card">
                  <div class="ba-card__media">
                    <Pic src={t.image} widths={[480, 720, 960]} sizes="(min-width: 768px) 420px, 300px" alt={copy === 0 ? t.alt : ''} class="ba-card__img" />
                    <span class="ba-label ba-label--before" aria-hidden="true">Antes</span>
                    <span class="ba-label ba-label--after" aria-hidden="true">Después</span>
                  </div>
                  <p class="ba-card__name">{t.name}</p>
                  <p class="ba-card__line">{t.line}</p>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    )
  }

  <div class="marquee-row marquee-row--quotes" data-reveal>
    <h3 class="visually-hidden">Lo que dicen ellas</h3>
    <div class="marquee-row__track">
      {
        [0, 1].map((copy) => (
          <ul class="marquee-row__list" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {testimonials.map((t) => (
              <li class="quote-card">
                <Icon name="quote" size={28} class="quote-card__icon" />
                <p class="quote-card__text">{t.quote}</p>
                <p class="quote-card__name">{t.name}</p>
                <p class="quote-card__context">{t.context}</p>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <div class="container">
    {show && <p class="micro results__disclaimer">Resultados individuales. Pueden variar según cada persona.</p>}
    <div class="section-cta" data-reveal>
      <a class="btn btn--block-mobile" href="#formulario" data-cta="resultados">Quiero ser la siguiente</a>
    </div>
  </div>
</section>

<style>
  .results {
    overflow: hidden;
  }

  /* Caso destacado */
  .featured {
    display: grid;
    gap: 22px;
    max-width: 1040px;
    margin: clamp(32px, 5vw, 56px) auto 0;
    padding: 14px 14px 26px;
    border-radius: 28px;
    background: var(--white);
    box-shadow: 0 24px 50px -36px rgb(214 63 132 / 0.6);
  }
  .featured__media {
    position: relative;
  }
  .featured__media :global(.featured__img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 18px;
    background: var(--lilac-50);
  }
  .featured__body {
    padding-inline: 10px;
  }
  .featured__body h3 {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
  }
  .featured__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 18px 0 0;
    padding: 0;
  }
  .featured__stats li {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--blush);
  }
  .featured__num {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.05;
    color: var(--pink-strong);
  }
  .featured__label {
    font-size: var(--fs-small);
    color: var(--muted);
    line-height: 1.3;
  }
  .featured__quote {
    margin: 18px 0 0;
    padding-left: 14px;
    border-left: 3px solid var(--pink);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  /* Etiquetas sobre la imagen doble (antes a la izquierda, después a la derecha) */
  .ba-label {
    position: absolute;
    bottom: 10px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .ba-label--before {
    left: 10px;
    background: rgb(30 21 48 / 0.75);
    color: var(--white);
  }
  .ba-label--after {
    left: calc(50% + 10px);
    background: var(--pink-strong);
    color: var(--white);
  }

  /* Filas en bucle infinito: dos copias de la lista, la pista se desplaza el 50 % */
  .marquee-row {
    margin-top: clamp(36px, 5vw, 56px);
    overflow: hidden;
  }
  .marquee-row + .marquee-row {
    margin-top: 18px;
  }
  .marquee-row__track {
    display: flex;
    width: max-content;
    animation: row-left 90s linear infinite;
  }
  .marquee-row--quotes .marquee-row__track {
    animation-name: row-right;
    animation-duration: 120s;
  }
  .marquee-row:hover .marquee-row__track,
  .marquee-row:focus-within .marquee-row__track {
    animation-play-state: paused;
  }
  .marquee-row__list {
    display: flex;
    flex: none;
    gap: 14px;
    margin: 0;
    padding: 0 14px 0 0;
  }
  @keyframes row-left {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes row-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: none;
    }
  }

  .ba-card {
    flex: none;
    width: 300px;
  }
  .ba-card__media {
    position: relative;
  }
  .ba-card__media :global(.ba-card__img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 18px;
    background: var(--lilac-50);
  }
  .ba-card__name {
    margin-top: 10px;
    font-weight: 600;
  }
  .ba-card__line {
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: 1.35;
  }

  .quote-card {
    display: flex;
    flex-direction: column;
    flex: none;
    width: 290px;
    padding: 22px 22px 20px;
    border-radius: 18px;
    background: var(--white);
    box-shadow: 0 14px 30px -24px rgb(214 63 132 / 0.6);
  }
  .quote-card :global(.quote-card__icon) {
    color: var(--pink);
    margin-bottom: 10px;
  }
  .quote-card__text {
    flex: 1;
    font-size: 1rem;
    line-height: 1.45;
  }
  .quote-card__name {
    margin-top: 16px;
    font-weight: 600;
  }
  .quote-card__context {
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .results__disclaimer {
    margin-top: 16px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .ba-card {
      width: 420px;
    }
    .marquee-row__list {
      gap: 18px;
      padding-right: 18px;
    }
    .quote-card {
      width: 340px;
      padding: 26px 26px 22px;
    }
  }
  @media (min-width: 960px) {
    .featured {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
      gap: 36px;
      padding: 18px 36px 18px 18px;
    }
    .featured__body {
      padding: 0;
    }
    .featured__num {
      font-size: 2.5rem;
    }
  }

  /* Sin movimiento: filas estáticas que se deslizan con el dedo */
  @media (prefers-reduced-motion: reduce) {
    .marquee-row {
      overflow-x: auto;
      scrollbar-width: none;
      padding-inline: var(--gutter);
    }
    .marquee-row::-webkit-scrollbar {
      display: none;
    }
    .marquee-row__track {
      animation: none;
    }
    .marquee-row__list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
