---
import Icon from './Icon.astro';
import { hasWhatsApp, whatsappUrl } from '../config/site';
// Mientras no haya número de WhatsApp en site.ts, el botón lleva al formulario.
---

<aside class="mobilebar" aria-label="Acceso rápido" data-mobilebar inert>
  <a class="btn mobilebar__cta" href="#formulario" data-cta="barra-movil">Quiero mi plaza</a>
  {
    hasWhatsApp ? (
      <a class="mobilebar__wa" href={whatsappUrl()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" data-contact="whatsapp" data-location="barra-movil">
        <Icon name="whatsapp" size={28} />
      </a>
    ) : (
      <a class="mobilebar__wa" href="#formulario" aria-label="WhatsApp: déjanos tu número en el formulario y te escribimos" data-wa-pending>
        <Icon name="whatsapp" size={28} />
      </a>
    )
  }
</aside>

<style>
  .mobilebar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom, 0px));
    background: rgb(255 255 255 / 0.95);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--line);
    transform: translateY(110%);
    visibility: hidden;
    transition:
      transform 0.25s var(--ease),
      visibility 0.25s;
  }
  .mobilebar:global(.is-visible) {
    transform: none;
    visibility: visible;
  }
  .mobilebar__cta {
    flex: 1;
    min-width: 0;
  }
  .mobilebar__wa {
    display: grid;
    place-items: center;
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--purple);
    color: var(--white);
    box-shadow: 0 6px 14px -8px rgb(75 42 145 / 0.8);
    transition:
      transform 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .mobilebar__wa:hover {
    background: var(--purple-dark);
  }
  .mobilebar__wa:active {
    transform: scale(0.96);
  }
  @media (min-width: 768px) {
    .mobilebar {
      display: none;
    }
  }
</style>
