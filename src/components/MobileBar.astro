---
// Barra fija inferior en móvil: un solo botón, al formulario.
---

<aside class="mobilebar" aria-label="Acceso rápido" data-mobilebar inert>
  <a class="btn mobilebar__cta" href="#formulario" data-cta="barra-movil">Quiero mi plaza</a>
</aside>

<style>
  .mobilebar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom, 0px));
    background: rgb(255 255 255 / 0.95);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--line);
    transform: translateY(110%);
    visibility: hidden;
    transition:
      transform 0.25s var(--ease),
      visibility 0.25s;
  }
  .mobilebar:global(.is-visible) {
    transform: none;
    visibility: visible;
  }
  .mobilebar__cta {
    flex: 1;
    min-width: 0;
  }
  @media (min-width: 768px) {
    .mobilebar {
      display: none;
    }
  }
</style>
