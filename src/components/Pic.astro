---
/**
 * <picture> con WebP, srcset responsive y dirección de arte opcional
 * (un recorte distinto por breakpoint). Siempre con width/height para CLS cero.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { buildSources, clampWidths, DEFAULT_QUALITY } from '../lib/images';

interface ArtSource {
  src: ImageMetadata;
  media: string;
  widths: number[];
  sizes: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  art?: ArtSource[];
  priority?: boolean;
  class?: string;
  pictureClass?: string;
  /** Calidad WebP (0 a 100). */
  quality?: number;
}

const { src, alt, widths, sizes, art = [], priority = false, class: className, pictureClass, quality = DEFAULT_QUALITY } = Astro.props;

const artBuilt = await Promise.all(art.map(async (a) => ({ ...a, built: await buildSources(a.src, a.widths, quality) })));
const main = await buildSources(src, widths, quality);
const list = clampWidths(src, widths);
const fallback = await getImage({ src, width: list[Math.min(1, list.length - 1)], format: 'webp', quality });
---

<picture class={pictureClass}>
  {
    artBuilt.map((a) => (
      <source type="image/webp" media={a.media} srcset={a.built.webp.srcSet.attribute} sizes={a.sizes} width={a.built.width} height={a.built.height} />
    ))
  }
  <img
    class={className}
    src={fallback.src}
    srcset={main.webp.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width={main.width}
    height={main.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</picture>
