---
import Logo from './Logo.astro';

interface Props {
  /** En la home el CTA es un ancla; en el resto de páginas apunta a la home. */
  home?: boolean;
  /** Mostrar el botón "Quiero mi plaza" (se oculta en /gracias). */
  cta?: boolean;
}
const { home = true, cta = true } = Astro.props;
const base = home ? '' : '/';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <Logo href={home ? '#top' : '/'} />
    {cta && <a class="btn site-header__cta" href={`${base}#formulario`} data-cta="header">Quiero mi plaza</a>}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgb(255 255 255 / 0.94);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  :global(.is-scrolled) .site-header,
  .site-header:global(.is-scrolled) {
    border-bottom-color: var(--line);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .site-header__cta {
    min-height: 46px;
    min-width: 0;
    padding: 0 20px;
    font-size: 0.9375rem;
  }
  @media (min-width: 768px) {
    .site-header__cta {
      min-height: 50px;
      padding: 0 26px;
      font-size: 1rem;
    }
  }
</style>
