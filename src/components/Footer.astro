---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const base = home ? '' : '/';
const year = new Date().getFullYear();
// Sin enlaces de contacto ni redes: la única salida es el formulario. Las legales se abren en pestaña nueva.
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo href={home ? '#top' : '/'} variant="footer" />
        <p>Programa online de transformación física para mujeres +30.</p>
        <a class="btn btn--light site-footer__cta" href={`${base}#formulario`} data-cta="footer">Quiero mi plaza</a>
      </div>

      <nav class="site-footer__col" aria-labelledby="f-web">
        <h2 id="f-web">Web</h2>
        <ul role="list">
          <li><a href={`${base}#como-funciona`}>Cómo funciona</a></li>
          <li><a href={`${base}#resultados`}>Resultados</a></li>
          <li><a href={`${base}#preguntas`}>Preguntas</a></li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-labelledby="f-legal">
        <h2 id="f-legal">Legal</h2>
        <ul role="list">
          <li><a href="/aviso-legal" target="_blank" rel="noopener">Aviso legal</a></li>
          <li><a href="/privacidad" target="_blank" rel="noopener">Política de privacidad</a></li>
          <li><a href="/cookies" target="_blank" rel="noopener">Política de cookies</a></li>
          <li><button type="button" class="site-footer__cookies" data-open-cookies>Configurar cookies</button></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>
        © <span data-year>{year}</span> Pomposo y Peligroso · {SITE.legal.company} · CIF {SITE.legal.cif} · Gavà, Barcelona · Web creada por <a class="site-footer__credit" href="https://www.aasmarketing.com/">AAS Marketing</a>
      </p>
      <p class="site-footer__disclaimer">Los resultados dependen de cada persona. Este programa no sustituye el consejo médico.</p>
      <a class="site-footer__top" href="#top">Volver arriba <Icon name="arrow-up" size={18} /></a>
    </div>
  </div>
  <div class="site-footer__giant" aria-hidden="true" data-text="Pomposo y Peligroso"></div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark);
    padding-top: clamp(64px, 8vw, 96px);
    font-size: var(--fs-small);
  }
  .site-footer__grid {
    display: grid;
    gap: 40px;
  }
  .site-footer__brand p {
    margin-top: 16px;
    max-width: 30ch;
    color: var(--on-dark);
  }
  .site-footer__cta {
    margin-top: 20px;
  }
  .site-footer__col h2 {
    font-family: var(--font-text);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 10px;
  }
  .site-footer__col ul {
    display: grid;
    gap: 2px;
  }
  .site-footer__col a,
  .site-footer__cookies {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    text-decoration: none;
    text-align: left;
    overflow-wrap: break-word;
    transition: color 0.2s ease;
  }
  .site-footer__col a:hover,
  .site-footer__cookies:hover {
    color: var(--lilac);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .site-footer__bottom {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid rgb(233 224 255 / 0.16);
    display: grid;
    gap: 10px;
    color: var(--on-dark);
  }
  .site-footer__disclaimer {
    font-size: var(--fs-micro);
  }
  .site-footer__credit {
    color: inherit;
    text-decoration: none;
  }
  .site-footer__credit:hover {
    color: var(--lilac);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .site-footer__top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    width: fit-content;
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
  }
  .site-footer__top:hover {
    color: var(--lilac);
  }
  /* Marca gigante decorativa (en ::before para que no cuente como texto).
     Ocupa el ancho del footer sin cortarse: el texto mide 8,43 em de ancho en Anton. */
  .site-footer__giant {
    container-type: inline-size;
    margin-top: 32px;
    padding: 0 0 calc(var(--mobile-safe-bottom, 0px) + 10px);
    user-select: none;
  }
  .site-footer__giant::before {
    content: attr(data-text);
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 11vw;
    font-size: calc((100cqi - 24px) / 8.5);
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--white);
    opacity: 0.08;
  }
  @media (max-width: 767px) {
    /* Hueco para que la barra fija móvil no tape el final del footer (solo en páginas con barra) */
    :global(body:has([data-mobilebar])) .site-footer {
      padding-bottom: calc(var(--mobilebar-h) + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 32px;
    }
    .site-footer__brand {
      grid-column: auto;
    }
  }
  @media (min-width: 1024px) {
    .site-footer__bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .site-footer__disclaimer {
      grid-column: 1;
    }
    .site-footer__top {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
