---
import Icon from './Icon.astro';
const pains = [
  'Mil dietas y siempre vuelvo al punto de partida.',
  'Empiezo el lunes con ganas y el jueves ya lo he dejado.',
  'Voy al gimnasio, pero mi glúteo sigue igual que hace un año.',
];
---

<section class="section bg-blush pains" aria-labelledby="pains-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="pains-title">Lo has probado todo <span class="script">¿te suena?</span></h2>
    </div>
    <ul class="pains__list" role="list">
      {
        pains.map((p) => (
          <li class="pains__note" data-reveal>
            <Icon name="quote" size={34} class="pains__quote" />
            <p>{p}</p>
          </li>
        ))
      }
    </ul>
    <div class="section-cta" data-reveal>
      <a class="btn btn--block-mobile" href="#formulario" data-cta="dolores">Quiero cambiarlo</a>
    </div>
  </div>
</section>

<style>
  .pains__list {
    display: grid;
    gap: 18px;
    max-width: 1040px;
    margin: clamp(36px, 5vw, 60px) auto 0;
    padding: 0;
  }
  .pains__note {
    position: relative;
    padding: 22px 22px 24px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 18px 36px -28px rgb(214 63 132 / 0.55);
    transition: transform 0.3s var(--ease);
  }
  /* Notas un poco giradas, como pegadas en la nevera */
  .pains__note:nth-child(1) {
    transform: rotate(-1.6deg);
  }
  .pains__note:nth-child(2) {
    transform: rotate(1.2deg);
  }
  .pains__note:nth-child(3) {
    transform: rotate(-0.8deg);
  }
  .pains__note:hover {
    transform: rotate(0) translateY(-3px);
  }
  .pains__note :global(.pains__quote) {
    color: var(--pink);
    margin-bottom: 8px;
  }
  .pains__note p {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.35;
  }
  @media (min-width: 860px) {
    .pains__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .pains__note {
      padding: 34px 30px 36px;
    }
    .pains__note p {
      font-size: 1.375rem;
    }
  }
</style>
