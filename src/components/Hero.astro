---
import Pic from './Pic.astro';
import heroV from '../assets/img/hero-flor-gluteo-vertical.jpg';
import heroH from '../assets/img/hero-clientas-entrenando-horizontal.jpg';
import { HERO } from '../lib/images';
import Icon from './Icon.astro';
import { transformations, featured } from '../data/transformations';

// Tres antes/después reales en miniatura: prueba de resultados en la primera pantalla
const proof = [featured.image, transformations.find((t) => t.name === 'Ariadna')!.image, transformations.find((t) => t.name === 'Claudia')!.image];
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <Pic
      src={heroH}
      art={[{ src: heroV, media: HERO.media, widths: HERO.mobileWidths, sizes: HERO.sizesMobile }]}
      widths={HERO.desktopWidths}
      sizes={HERO.sizesDesktop}
      quality={HERO.quality}
      alt=""
      priority
      class="hero__img"
    />
  </div>

  <div class="container hero__content">
    <h1 id="hero-title" class="hero__title t-center">Un glúteo pomposo <span class="script">y peligroso.</span></h1>
    <p class="hero__lead">Programa online de 12 semanas para mujeres +30.<br />Fuerza, comida sin dietas y un coach pendiente de ti.</p>
    <div class="hero__ctas">
      <a class="btn" href="#formulario" data-hero-cta data-cta="hero">Quiero mi plaza</a>
      <p class="hero__note"><Icon name="check" size={16} /> Videollamada sin compromiso</p>
    </div>
    <a class="proof" href="#resultados">
      <span class="proof__thumbs" aria-hidden="true">
        {proof.map((img) => <Pic src={img} widths={[160]} sizes="80px" quality={60} alt="" class="proof__img" />)}
      </span>
      <span class="proof__text">Mira los resultados de nuestras alumnas</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    background: var(--ink);
    color: var(--white);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__bg :global(picture),
  .hero__bg :global(.hero__img) {
    width: 100%;
    height: 100%;
  }
  .hero__bg :global(.hero__img) {
    object-fit: cover;
    object-position: 50% 0%;
  }
  /* Velo: deja ver la foto (el glúteo de Flor llega hasta el titular) y oscurece donde va el texto pequeño y los botones */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgb(30 21 48 / 0.15) 0%,
      rgb(30 21 48 / 0.08) 30%,
      rgb(30 21 48 / 0.38) 50%,
      rgb(30 21 48 / 0.86) 66%,
      rgb(30 21 48 / 0.96) 100%
    );
  }
  .hero__content {
    position: relative;
    padding-top: 24px;
    padding-bottom: 36px;
    text-align: center;
  }
  /* Más apretado que el resto: la segunda línea (POMPOSO) no lleva tilde */
  .hero__title {
    font-size: var(--fs-h1);
    line-height: 0.98;
    text-shadow: 0 2px 24px rgb(30 21 48 / 0.55);
  }
  .hero__lead {
    max-width: 34rem;
    margin: 18px auto 0;
    color: var(--on-dark);
    font-size: 1.0625rem;
    line-height: 1.5;
    text-wrap: balance;
  }
  .hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    margin-top: 22px;
  }
  .hero__note {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--on-dark);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .hero__note :global(svg) {
    color: var(--pink);
    stroke-width: 2.5;
  }
  /* Tira de antes/después: lleva a la sección de resultados */
  .proof {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin-top: 16px;
    padding: 6px 14px 6px 6px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.12);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--white);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    text-align: left;
    line-height: 1.25;
    transition: background-color 0.2s ease;
  }
  .proof:hover {
    background: rgb(255 255 255 / 0.2);
  }
  .proof__thumbs {
    display: flex;
    flex: none;
  }
  .proof__thumbs :global(.proof__img) {
    width: 54px;
    height: 36px;
    object-fit: cover;
    border-radius: 8px;
    border: 2px solid var(--white);
  }
  .proof__thumbs :global(picture + picture) {
    margin-left: -10px;
  }
  .proof__text {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  /* En escritorio el aviso de cookies va abajo: mientras no hay elección guardada, el hero reserva
     su hueco desde el primer pintado (clase needs-consent del script inline de Base.astro), sin saltos */
  @media (min-width: 960px) {
    :global(html.needs-consent) .hero {
      padding-bottom: 120px;
    }
  }
  @media (min-width: 600px) {
    .hero__ctas {
      align-items: center;
    }
    .hero__ctas .btn {
      min-width: 280px;
    }
    .hero__lead {
      font-size: 1.125rem;
    }
  }
  @media (min-width: 960px) {
    .hero {
      align-items: center;
      min-height: max(560px, calc(100svh - var(--header-h)));
    }
    .hero__bg :global(.hero__img) {
      object-position: 50% 50%;
    }
    /* Tríptico de clientas entrenando: el panel central queda bajo el titular, más oscuro */
    .hero::after {
      background:
        radial-gradient(ellipse 42% 70% at 50% 52%, rgb(30 21 48 / 0.82) 0%, rgb(30 21 48 / 0.6) 65%, rgb(30 21 48 / 0.35) 100%),
        linear-gradient(180deg, rgb(30 21 48 / 0.25) 0%, rgb(30 21 48 / 0.1) 35%, rgb(30 21 48 / 0.65) 100%);
    }
    .hero__title {
      max-width: 7.6em;
      margin-inline: auto;
      /* En pantallas bajas (portátiles de 768 px) el titular se reduce para que quepa todo */
      font-size: min(var(--fs-h1), 13.5svh);
    }
    .hero__content {
      padding-block: clamp(56px, 8vh, 96px);
    }
    .hero__lead {
      margin-top: 26px;
      font-size: 1.25rem;
      max-width: 38rem;
    }
    .hero__ctas {
      margin-top: 36px;
    }
  }
</style>
