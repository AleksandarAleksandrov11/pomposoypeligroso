---
import Pic from './Pic.astro';
import heroV from '../assets/img/hero-mujer-sentadilla-barra-vertical.jpg';
import heroH from '../assets/img/hero-mujer-sentadilla-barra-horizontal.jpg';
import { HERO } from '../lib/images';
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <Pic
      src={heroH}
      art={[{ src: heroV, media: HERO.media, widths: HERO.mobileWidths, sizes: HERO.sizesMobile }]}
      widths={HERO.desktopWidths}
      sizes={HERO.sizesDesktop}
      quality={HERO.quality}
      alt=""
      priority
      class="hero__img"
    />
  </div>

  <div class="container hero__content">
    <h1 id="hero-title" class="hero__title t-center">Un glúteo pomposo <span class="script">y peligroso.</span></h1>
    <p class="hero__lead">Programa online de 12 semanas para mujeres +30.<br />Fuerza, comida sin dietas y una entrenadora pendiente de ti.</p>
    <div class="hero__ctas">
      <a class="btn" href="#formulario" data-hero-cta data-cta="hero">Quiero mi plaza</a>
      <a class="btn btn--outline-light" href="#resultados">Ver resultados</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    background: var(--ink);
    color: var(--white);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__bg :global(picture),
  .hero__bg :global(.hero__img) {
    width: 100%;
    height: 100%;
  }
  .hero__bg :global(.hero__img) {
    object-fit: cover;
    object-position: 50% 18%;
  }
  /* Velo: deja ver la foto arriba y oscurece donde va el texto */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgb(30 21 48 / 0.2) 0%,
      rgb(30 21 48 / 0.12) 26%,
      rgb(30 21 48 / 0.62) 50%,
      rgb(30 21 48 / 0.92) 72%,
      rgb(30 21 48 / 0.97) 100%
    );
  }
  .hero__content {
    position: relative;
    padding-top: 24px;
    padding-bottom: 36px;
    text-align: center;
  }
  /* Más apretado que el resto: la segunda línea (POMPOSO) no lleva tilde */
  .hero__title {
    font-size: var(--fs-h1);
    line-height: 0.98;
  }
  .hero__lead {
    max-width: 34rem;
    margin: 18px auto 0;
    color: var(--on-dark);
    font-size: 1.0625rem;
    line-height: 1.5;
    text-wrap: balance;
  }
  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 24px;
  }
  /* En escritorio el aviso de cookies va abajo: mientras no hay elección guardada, el hero reserva
     su hueco desde el primer pintado (clase needs-consent del script inline de Base.astro), sin saltos */
  @media (min-width: 960px) {
    :global(html.needs-consent) .hero {
      padding-bottom: 120px;
    }
  }
  @media (min-width: 600px) {
    .hero__ctas {
      flex-direction: row;
      justify-content: center;
      gap: 14px;
    }
    .hero__lead {
      font-size: 1.125rem;
    }
  }
  @media (min-width: 960px) {
    .hero {
      align-items: center;
      min-height: max(560px, calc(100svh - var(--header-h)));
    }
    .hero__bg :global(.hero__img) {
      object-position: 100% 50%;
    }
    .hero::after {
      background:
        radial-gradient(ellipse 46% 62% at 50% 52%, rgb(30 21 48 / 0.7) 0%, rgb(30 21 48 / 0.42) 62%, rgb(30 21 48 / 0.18) 100%),
        linear-gradient(180deg, rgb(30 21 48 / 0.2) 0%, rgb(30 21 48 / 0) 35%, rgb(30 21 48 / 0.6) 100%);
    }
    .hero__title {
      max-width: 7.6em;
      margin-inline: auto;
      /* En pantallas bajas (portátiles de 768 px) el titular se reduce para que quepa todo */
      font-size: min(var(--fs-h1), 13.5svh);
    }
    .hero__content {
      padding-block: clamp(56px, 8vh, 96px);
    }
    .hero__lead {
      margin-top: 26px;
      font-size: 1.25rem;
      max-width: 38rem;
    }
    .hero__ctas {
      margin-top: 36px;
    }
  }
</style>
