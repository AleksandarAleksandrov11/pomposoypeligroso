---
import Icon from './Icon.astro';
import { testimonials, exampleTestimonials, SHOW_EXAMPLE_TESTIMONIALS, type Testimonial } from '../data/testimonials';

// Solo testimonios reales (mínimo 2). Los de ejemplo solo en `npm run dev` y con el flag activado.
let list: Testimonial[] = testimonials;
const isExample = list.length < 2 && SHOW_EXAMPLE_TESTIMONIALS && import.meta.env.DEV;
if (isExample) list = exampleTestimonials;
const render = list.length >= 2;
---

{
  render && (
    <section class="section testimonials" aria-labelledby="testimonials-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2 id="testimonials-title">
            Lo que <span class="script">dicen ellas.</span>
          </h2>
        </div>
        <div class="carousel" data-carousel data-reveal>
          <ul class="carousel__track" role="list" data-carousel-track aria-label="Testimonios de alumnas">
            {list.map((t, i) => (
              <li class="t-card">
                <Icon name="quote" size={26} class="t-card__quote" />
                <p class="t-card__text">{t.quote}</p>
                <div class="t-card__foot">
                  <div>
                    <p class="t-card__name">{t.name}</p>
                    <p class="t-card__context">{t.context}</p>
                  </div>
                  <button type="button" class="link t-card__more" data-dialog-open={`testimonio-${i}`}>
                    Leer más<span class="visually-hidden"> de {t.name}</span>
                  </button>
                </div>
                <dialog id={`testimonio-${i}`} class="t-dialog" aria-labelledby={`testimonio-${i}-name`} data-testimonial-dialog>
                  <div class="t-dialog__inner">
                    <button type="button" class="t-dialog__close" aria-label="Cerrar" data-dialog-close>
                      <Icon name="close" size={22} />
                    </button>
                    <Icon name="quote" size={30} class="t-card__quote" />
                    <p class="t-dialog__text">{t.full}</p>
                    <p class="t-card__name" id={`testimonio-${i}-name`}>
                      {t.name}
                    </p>
                    <p class="t-card__context">{t.context}</p>
                  </div>
                </dialog>
              </li>
            ))}
          </ul>
          <div class="carousel__nav">
            <button type="button" class="carousel__btn" aria-label="Testimonio anterior" data-carousel-prev>
              <Icon name="chevron-left" size={22} />
            </button>
            <button type="button" class="carousel__btn" aria-label="Testimonio siguiente" data-carousel-next>
              <Icon name="chevron-right" size={22} />
            </button>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .carousel {
    margin-top: clamp(32px, 5vw, 56px);
  }
  .carousel__track {
    display: flex;
    gap: 14px;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) 6px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .t-card {
    flex: 0 0 84%;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 26px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    scroll-snap-align: start;
  }
  .t-card :global(.t-card__quote) {
    color: var(--lilac);
  }
  .t-card__text {
    flex: 1;
    font-size: 1.0625rem;
  }
  .t-card__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .t-card__name {
    font-weight: 600;
  }
  .t-card__context {
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .t-card__more {
    flex: none;
    padding: 0;
    border: 0;
    background: none;
  }
  .t-dialog {
    width: min(560px, calc(100% - 24px));
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
  }
  .t-dialog::backdrop {
    background: rgb(30 21 48 / 0.55);
  }
  .t-dialog__inner {
    position: relative;
    display: grid;
    gap: 14px;
    padding: 28px 24px 26px;
  }
  .t-dialog__close {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
  }
  .t-dialog__close:hover {
    background: var(--lilac-50);
  }
  .carousel__nav {
    display: none;
  }
  @media (min-width: 700px) {
    .t-card {
      flex-basis: 46%;
    }
  }
  @media (min-width: 900px) {
    .carousel__nav {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 20px;
    }
    .carousel:global(.is-static) .carousel__nav {
      display: none;
    }
    .carousel__btn {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: var(--white);
      color: var(--ink);
    }
    .carousel__btn:disabled {
      opacity: 0.35;
    }
  }
  @media (min-width: 1100px) {
    .carousel__track {
      margin: 0;
      padding: 0 0 6px;
      scroll-padding-inline: 0;
      gap: 18px;
    }
    .t-card {
      flex-basis: calc((100% - 36px) / 3);
    }
  }
</style>
