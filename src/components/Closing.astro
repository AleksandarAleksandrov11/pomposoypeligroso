---
import Pic from './Pic.astro';
import imgH from '../assets/img/mujer-zancada-gimnasio-luminoso.jpg';
import imgV from '../assets/img/mujer-zancada-gimnasio-luminoso-vertical.jpg';
---

<section class="closing on-dark" aria-labelledby="closing-title">
  <div class="closing__bg" aria-hidden="true">
    <Pic
      src={imgH}
      art={[{ src: imgV, media: '(max-width: 767px)', widths: [480, 768, 1000], sizes: '100vw' }]}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      alt=""
      class="closing__img"
    />
  </div>
  <div class="container closing__content">
    <h2 id="closing-title" data-reveal>Tu glúteo no se va a poner pomposo <span class="script">solo.</span></h2>
    <div class="closing__cta" data-reveal>
      <a class="btn btn--light btn--block-mobile" href="#formulario" data-cta="cierre">Quiero mi plaza</a>
      <p class="closing__note">Plazas limitadas para poder acompañar bien a cada alumna.</p>
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(96px, 14vw, 180px);
    color: var(--white);
    text-align: center;
  }
  .closing__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .closing__bg :global(picture),
  .closing__bg :global(.closing__img) {
    width: 100%;
    height: 100%;
  }
  .closing__bg :global(.closing__img) {
    object-fit: cover;
    object-position: 50% 40%;
  }
  .closing::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(75 42 145 / 0.8);
  }
  .closing__content h2 {
    max-width: 820px;
    margin-inline: auto;
    font-size: clamp(2.25rem, 1.4rem + 4vw, 4.25rem);
  }
  .closing__cta {
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-top: 36px;
  }
  .closing__note {
    color: var(--on-dark);
    font-size: var(--fs-small);
  }
  @media (max-width: 599px) {
    .closing__cta {
      justify-items: stretch;
    }
  }
</style>
