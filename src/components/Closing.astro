---
import Pic from './Pic.astro';
import imgH from '../assets/img/fondo-cierre-flor-gluteo.jpg';
import imgV from '../assets/img/fondo-cierre-flor-gluteo-vertical.jpg';
---

<section class="closing on-dark" aria-labelledby="closing-title">
  <div class="closing__bg" aria-hidden="true">
    <Pic
      src={imgH}
      art={[{ src: imgV, media: '(max-width: 767px)', widths: [480, 768, 1000], sizes: '100vw' }]}
      widths={[960, 1440, 1920, 2400]}
      sizes="100vw"
      quality={52}
      alt=""
      class="closing__img"
    />
  </div>
  <div class="container closing__content">
    <h2 id="closing-title" class="t-center" data-reveal>Tu glúteo no se va a poner pomposo <span class="script">solo.</span></h2>
    <div class="closing__cta" data-reveal>
      <a class="btn btn--light btn--block-mobile" href="#formulario" data-cta="cierre">Quiero mi plaza</a>
      <p class="closing__note">Plazas limitadas para poder acompañar bien a cada alumna.</p>
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: min(80svh, 760px);
    padding-block: clamp(88px, 12vw, 150px);
    background: var(--ink);
    color: var(--white);
    text-align: center;
  }
  .closing__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .closing__bg :global(picture),
  .closing__bg :global(.closing__img) {
    width: 100%;
    height: 100%;
  }
  .closing__bg :global(.closing__img) {
    object-fit: cover;
    object-position: 50% 50%;
  }
  .closing::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 60% at 50% 50%, rgb(30 21 48 / 0.62), rgb(30 21 48 / 0.3) 100%),
      linear-gradient(180deg, rgb(75 42 145 / 0.35), rgb(30 21 48 / 0.55));
  }
  .closing__content h2 {
    max-width: 11em;
    margin-inline: auto;
    font-size: clamp(2.75rem, 1.6rem + 5.2vw, 6rem);
  }
  .closing__content .script {
    font-size: 1.45em;
    margin-top: -0.16em;
  }
  .closing__cta {
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-top: 32px;
  }
  .closing__note {
    color: var(--on-dark);
    font-size: var(--fs-small);
  }
  @media (max-width: 599px) {
    .closing__cta {
      justify-items: stretch;
    }
  }
</style>
