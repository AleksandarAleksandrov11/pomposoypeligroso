---
import Icon from './Icon.astro';
const yes = [
  'Tienes más de 30 años y poco tiempo.',
  'Quieres un glúteo más firme y perder grasa.',
  'Estás cansada de empezar y dejarlo.',
  'Quieres aprender a comer sin pasar hambre.',
  'Valoras que alguien te acompañe de verdad.',
];
const no = [
  'Buscas una rutina gratis o una app barata.',
  'Quieres resultados en dos semanas.',
  'No estás dispuesta a comprometerte 12 semanas.',
];
---

<section class="section foryou" aria-labelledby="foryou-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="foryou-title">Es para ti <span class="script">si...</span></h2>
    </div>
    <div class="foryou__grid">
      <div class="foryou__card foryou__card--yes" data-reveal>
        <ul role="list" aria-labelledby="foryou-title">
          {
            yes.map((t) => (
              <li>
                <Icon name="check" size={20} class="foryou__icon" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="foryou__card foryou__card--no" data-reveal>
        <h3>No es para ti si:</h3>
        <ul role="list">
          {
            no.map((t) => (
              <li>
                <Icon name="cross" size={20} class="foryou__icon" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .foryou__grid {
    display: grid;
    gap: 14px;
    max-width: 960px;
    margin: clamp(32px, 5vw, 56px) auto 0;
  }
  .foryou__card {
    padding: 26px 24px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .foryou__card h3 {
    font-size: 1.375rem;
    margin-bottom: 12px;
  }
  .foryou__card ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .foryou__card li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    line-height: 1.45;
  }
  .foryou__card :global(.foryou__icon) {
    flex: none;
    margin-top: 2px;
  }
  .foryou__card--yes {
    background: var(--lilac-50);
    border-color: var(--lilac-50);
  }
  .foryou__card--yes :global(.foryou__icon) {
    color: var(--purple);
  }
  .foryou__card--no {
    color: var(--muted);
  }
  .foryou__card--no :global(.foryou__icon) {
    color: #a39bb5;
  }
  @media (min-width: 800px) {
    .foryou__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 18px;
      align-items: start;
    }
    .foryou__card {
      padding: 32px;
    }
  }
</style>
