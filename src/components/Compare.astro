---
import Icon from './Icon.astro';
// Lo de siempre frente a lo que incluyen tus 12 semanas (antes había una sección aparte de "Qué incluye")
const rows: { old: string; t: string; d: string }[] = [
  { old: 'Rutina genérica descargada', t: 'Plan de fuerza hecho para ti', d: '3 o 4 días por semana, 45 minutos, según tu nivel y tu material.' },
  { old: 'Dieta de pasar hambre', t: 'Nutrición sin dietas', d: 'Raciones y equivalencias para comer lo que te gusta.' },
  { old: 'Nadie revisa si lo cumples', t: 'Revisión cada semana', d: 'Peso, medidas, fotos y sensaciones. Con eso ajustamos tu plan.' },
  { old: 'Dudas sin resolver', t: 'Chat directo con tu coach', d: 'Y videollamadas para marcar los siguientes objetivos.' },
  { old: 'Lo dejas cuando baja la motivación', t: 'Alguien te sostiene cuando flojeas', d: '12 semanas acompañada de principio a fin.' },
];
---

<section class="section compare" aria-labelledby="compare-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="compare-title">Adiós a lo&nbsp;de&nbsp;siempre <span class="script">hola, Pomposo.</span></h2>
      <p>Esto es lo que incluyen tus 12 semanas.</p>
    </div>
    <div class="compare__grid">
      <div class="compare__card compare__card--old" data-reveal>
        <h3>Lo de siempre</h3>
        <ul role="list">
          {
            rows.map(({ old }) => (
              <li>
                <Icon name="cross" size={18} class="compare__icon" />
                <span>
                  <span class="compare__strike">{old}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <span class="compare__vs" aria-hidden="true">VS</span>

      <div class="compare__card compare__card--new on-dark" data-reveal>
        <h3>
          <svg class="compare__mono" viewBox="0 0 1584 1584" aria-hidden="true" focusable="false"><use href="#pyp-mono"></use></svg>
          Pomposo y Peligroso
        </h3>
        <ul role="list">
          {
            rows.map(({ t, d }) => (
              <li>
                <span class="compare__check" aria-hidden="true">
                  <Icon name="check" size={16} />
                </span>
                <span>
                  {t}
                  <span class="compare__detail">{d}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="section-cta" data-reveal>
      <a class="btn btn--block-mobile" href="#formulario" data-cta="comparativa">Quiero el plan pomposo</a>
    </div>
  </div>
</section>

<style>
  .compare__grid {
    position: relative;
    display: grid;
    max-width: 980px;
    margin: clamp(36px, 5vw, 60px) auto 0;
  }
  .compare__card {
    padding: 26px 22px;
    border-radius: 24px;
  }
  .compare__card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-bottom: 10px;
    font-size: 1.5rem;
  }
  .compare__card ul {
    display: grid;
    margin: 0;
    padding: 0;
  }
  .compare__card li {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    line-height: 1.35;
  }
  .compare__card li:first-child {
    border-top: 0;
  }

  /* Lo de siempre: apagado y tachado */
  .compare__card--old {
    background: var(--lilac-50);
    color: var(--muted);
    border: 1px dashed #cfc3e6;
  }
  .compare__card--old h3 {
    color: var(--muted);
  }
  .compare__card--old :global(.compare__icon) {
    flex: none;
    color: #b0a6c4;
  }
  .compare__strike {
    background: linear-gradient(var(--pink-strong), var(--pink-strong)) no-repeat 0 58% / 100% 2px;
    transition: background-size 0.5s var(--ease);
  }

  /* Pomposo: destacado */
  .compare__card--new {
    position: relative;
    background: var(--purple-dark);
    border: 1px solid var(--purple-dark);
    color: var(--white);
    box-shadow: 0 30px 60px -30px rgb(75 42 145 / 0.8);
  }
  .compare__card--new li {
    font-weight: 600;
    border-top-color: rgb(233 224 255 / 0.14);
  }
  .compare__mono {
    width: 40px;
    height: 40px;
    flex: none;
  }
  .compare__check {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink);
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .compare__detail {
    display: block;
    margin-top: 2px;
    color: var(--on-dark);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
  }
  .compare__check :global(svg) {
    stroke-width: 2.5;
  }

  /* VS */
  .compare__vs {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin: -14px auto;
    border-radius: 50%;
    background: var(--pink-strong);
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    box-shadow: 0 0 0 6px var(--white);
  }

  /* Animación al entrar en pantalla (solo si la sección estaba fuera al cargar) */
  .compare__card--old:global(.reveal) .compare__strike {
    background-size: 0% 2px;
  }
  .compare__card--old:global(.reveal.is-visible) .compare__strike {
    background-size: 100% 2px;
  }
  .compare__card--new:global(.reveal) .compare__check {
    transform: scale(0);
  }
  .compare__card--new:global(.reveal.is-visible) .compare__check {
    transform: scale(1);
  }
  .compare__card:global(.reveal.is-visible) li:nth-child(1) :is(.compare__strike, .compare__check) {
    transition-delay: 0.3s;
  }
  .compare__card:global(.reveal.is-visible) li:nth-child(2) :is(.compare__strike, .compare__check) {
    transition-delay: 0.45s;
  }
  .compare__card:global(.reveal.is-visible) li:nth-child(3) :is(.compare__strike, .compare__check) {
    transition-delay: 0.6s;
  }
  .compare__card:global(.reveal.is-visible) li:nth-child(4) :is(.compare__strike, .compare__check) {
    transition-delay: 0.75s;
  }
  .compare__card:global(.reveal.is-visible) li:nth-child(5) :is(.compare__strike, .compare__check) {
    transition-delay: 0.9s;
  }

  @media (min-width: 760px) {
    .compare__grid {
      /* Dos tarjetas iguales (mismo ancho y alto) y el VS justo en medio, montado lo mismo sobre cada una */
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      align-items: stretch;
    }
    .compare__card {
      padding: 32px 32px 26px;
    }
    .compare__vs {
      position: absolute;
      left: 50%;
      top: 50%;
      margin: 0;
      transform: translate(-50%, -50%);
      width: 72px;
      height: 72px;
      font-size: 1.75rem;
    }
  }
</style>
