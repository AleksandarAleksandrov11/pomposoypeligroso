---
import Pic from './Pic.astro';
import bg from '../assets/img/fondo-pasos-entrenamiento-grupo-the-monkeys.jpg';
// Título de cada paso en dos líneas
const steps = [
  { t: ['Rellenas el', 'formulario'], d: '4 preguntas, 30 segundos.' },
  { t: ['Hablamos por', 'videollamada'], d: 'Vemos tu caso y si el programa encaja contigo.' },
  { t: ['Empiezas tus', '12 semanas'], d: 'Con tu plan y tu entrenadora pendiente de ti.' },
];
---

<section class="steps on-dark" id="como-funciona" aria-labelledby="steps-title">
  <div class="steps__bg" aria-hidden="true">
    <Pic
      src={bg}
      widths={[640, 960, 1250]}
      sizes="(max-width: 767px) 240vw, 100vw"
      quality={{ avif: 50, webp: 66 }}
      alt=""
      class="steps__img"
    />
  </div>
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="steps-title">Así funciona <span class="script">en 3 pasos.</span></h2>
    </div>
    <ol class="steps__list" role="list" data-reveal>
      {
        steps.map((s, i) => (
          <li class="steps__item">
            <span class="steps__num" aria-hidden="true">
              {i + 1}
            </span>
            <h3>
              {s.t[0]}
              <br />
              {s.t[1]}
            </h3>
            <p>{s.d}</p>
          </li>
        ))
      }
    </ol>
    <div class="section-cta" data-reveal>
      <a class="btn btn--light btn--block-mobile" href="#formulario" data-cta="como-funciona">Empezar por el paso 1</a>
    </div>
  </div>
</section>

<style>
  .steps {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(64px, 8vw, 104px);
    background: var(--ink);
    color: var(--white);
  }
  .steps__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .steps__bg :global(picture),
  .steps__bg :global(.steps__img) {
    width: 100%;
    height: 100%;
  }
  .steps__bg :global(.steps__img) {
    object-fit: cover;
    object-position: 50% 60%;
  }
  .steps::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* La foto es muy luminosa: velo suficiente para que el texto blanco se lea encima */
    background: linear-gradient(180deg, rgb(30 21 48 / 0.76) 0%, rgb(30 21 48 / 0.64) 50%, rgb(75 42 145 / 0.8) 100%);
  }
  .steps__list {
    display: grid;
    gap: 0;
    max-width: 1000px;
    margin: clamp(36px, 5vw, 56px) auto 0;
    padding: 0;
    text-align: center;
  }
  .steps__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* Móvil: un trazo corto entre paso y paso */
  .steps__item:not(:last-child)::after {
    content: '';
    width: 2px;
    height: 22px;
    margin: 14px 0;
    background: var(--pink);
    opacity: 0.7;
  }
  .steps__num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1;
    box-shadow: 0 0 0 7px rgb(242 141 184 / 0.2);
  }
  .steps__item h3 {
    margin-bottom: 6px;
  }
  .steps__item p {
    max-width: 22rem;
    color: var(--on-dark);
  }
  @media (min-width: 860px) {
    .steps__list {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 40px;
    }
    .steps__num {
      width: 64px;
      height: 64px;
      margin-bottom: 18px;
      font-size: 1.75rem;
    }
    /* Escritorio: línea que une los centros de los círculos */
    .steps__item:not(:last-child)::after {
      position: absolute;
      top: 31px;
      left: calc(50% + 48px);
      width: calc(100% + 40px - 96px);
      height: 2px;
      margin: 0;
      background: linear-gradient(90deg, var(--pink) 0 60%, transparent 0) 0 0 / 12px 2px repeat-x;
      opacity: 0.9;
    }
  }
</style>
